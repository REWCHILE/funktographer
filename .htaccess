# Default Directory Index
DirectoryIndex index.php index.html

# Prevent directory browsing
Options -Indexes

# UTF-8 encoding
AddDefaultCharset UTF-8

# Compression (GZIP / Deflate)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

# Browser Caching (Expires Headers)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Images
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Video & Media
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
</IfModule>

# Cache-Control and Security Headers
<IfModule mod_headers.c>
    # 1 year cache for static assets with immutable
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>

    # Security Headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Transparent WebP delivery if supported by browser and file exists
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_FILENAME} \.(jpe?g|png)$ [NC]
    RewriteCond %{REQUEST_FILENAME} (.+)\.(jpe?g|png)$ [NC]
    RewriteCond %1.webp -f
    RewriteRule (.+)\.(jpe?g|png)$ $1.webp [T=image/webp,E=webp:1,L]

    # Block access to sensitive directories and files
    RewriteRule ^(database|includes)/ - [F,L]
    RewriteRule \.(sql|env|json|log)$ - [F,L]

    # Dynamic route: /proyecto/slug-del-proyecto -> proyecto.php?slug=slug-del-proyecto
    RewriteRule ^proyecto/([a-zA-Z0-9_-]+)/?$ proyecto.php?slug=$1 [L,QSA]

    # Dynamic route: /blog/slug-del-articulo -> blog-post.php?slug=slug-del-articulo
    RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-post.php?slug=$1 [L,QSA]

    # Alias /bio -> links.php
    RewriteRule ^bio/?$ links.php [L,QSA]

    # Redirect /page.php to /page (canonical SEO 301 redirect only for GET requests)
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Resolve extensionless URLs to .php files if they exist
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f [OR]
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]

    # Serve directory index
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.php -f
    RewriteRule ^(.+?)/?$ $1/index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header append Vary Accept env=webp
</IfModule>
